# Generate once: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
JOURNAL_KEY=
# Optional shared login password. JOURNAL_KEY remains the private signing secret.
# Use a strong passphrase: the login page is public and only rate-limited.
# Rotating JOURNAL_KEY signs out every device.
# Leave this unset to unlock with JOURNAL_KEY itself.
# JOURNAL_PASSWORD=
# Automatically added when the private Blob store is connected to Vercel.
BLOB_STORE_ID=
# Optional legacy credential; connected stores use Vercel OIDC automatically.
BLOB_READ_WRITE_TOKEN=
# Local development only: the server saves JSON to data/journal.json.
LOCAL_FILE_STORAGE=1
